{
  "name": "frontline-zero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:smoke": "node scripts/smoke.mjs",
    "smoke:shot": "SMOKE_SHOT=/tmp/fz-smoke.png node scripts/smoke.mjs",
    "server": "tsx server/index.ts",
    "test:net": "node scripts/smoke-net.mjs",
    "build:deb": "npm run build && electron-builder --linux deb",
    "dist": "electron-builder --linux deb"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "three": "^0.169.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.169.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.8.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "build": {
    "appId": "com.frontlinezero.game",
    "productName": "Frontline Zero",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Game",
      "desktop": {
        "Name": "Frontline Zero",
        "Comment": "A low-poly multiplayer FPS",
        "Exec": "frontline-zero",
        "Icon": "frontline-zero"
      }
    },
    "deb": {
      "depends": [
        "libnss3",
        "libxss1",
        "libasound2",
        "libgbm1"
      ]
    }
  }
}
